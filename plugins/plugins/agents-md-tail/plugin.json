  "keywords": [
    "agents.md",
    "context",
    "instructions",
    "prompt",
    "acp"
  ],
  "extensions": {
    "com.ryuhq.ryu": {
      "id": "@ryu/agents-md-tail",
      "displayName": "AGENTS.md Tail"
