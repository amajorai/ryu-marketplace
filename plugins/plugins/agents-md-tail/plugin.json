{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "ryu.agents-md-tail",
  "version": "0.1.14",
  "description": "Experimental context hook that repeats the active AGENTS.md instructions at the end of the latest message on each model turn, without editing the system prompt or chat history.",
  "author": {
    "name": "Ryu",
    "url": "https://ryuhq.com"
  },
  "homepage": "https://github.com/amajorai/ryu-marketplace/tree/main/plugins/plugins/agents-md-tail",
  "repository": "https://github.com/amajorai/ryu-marketplace/tree/main/plugins/plugins/agents-md-tail",
  "keywords": [
    "agents.md",
    "context",
    "instructions",
    "prompt",
    "acp"
  ],
  "extensions": {
    "com.ryuhq.ryu": {
      "id": "@ryu/agents-md-tail",
      "displayName": "AGENTS.md Tail"
    }
  }
}
