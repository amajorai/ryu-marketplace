{
  "tool": "browser.scroll",
  "kind": "adapter",
  "code_file": "adapters/browser.scroll.js",
  "adapter_tools": ["agentbrowser.agent_browser_tab_switch"],
  "cases": [
    {
      "name": "acts on the current tab without switching",
      "input": {
        "direction": "down"
      },
      "provider": {
        "call": [
          {
            "content": [
              {
                "type": "text",
                "text": "ok"
              }
            ]
          }
        ]
      },
      "expect": {
        "content": [
          {
            "type": "text",
            "text": "ok"
          }
        ]
      },
      "expectCalls": [
        {
          "path": "callTool",
          "args": {
            "direction": "down"
          }
        }
      ]
    },
    {
      "name": "switches to the requested tab first",
      "input": {
        "tab_id": "2",
        "direction": "up",
        "amount": 3
      },
      "provider": {
        "call": [
          {
            "content": [
              {
                "type": "text",
                "text": "ok"
              }
            ]
          }
        ],
        "named": {
          "agentbrowser.agent_browser_tab_switch": [
            {
              "content": []
            }
          ]
        }
      },
      "expect": {
        "content": [
          {
            "type": "text",
            "text": "ok"
          }
        ]
      },
      "expectCalls": [
        {
          "path": "callNamed:agentbrowser.agent_browser_tab_switch",
          "args": {
            "tab": "2"
          }
        },
        {
          "path": "callTool",
          "args": {
            "direction": "up",
            "amount": 3
          }
        }
      ]
    },
    {
      "name": "a failed tab switch stops before acting",
      "input": {
        "tab_id": "9",
        "direction": "down"
      },
      "provider": {
        "named": {
          "agentbrowser.agent_browser_tab_switch": [
            {
              "isError": true,
              "content": [
                {
                  "type": "text",
                  "text": "no tab 9"
                }
              ]
            }
          ]
        }
      },
      "expect": {
        "isError": true,
        "content": [
          {
            "type": "text",
            "text": "no tab 9"
          }
        ]
      },
      "expectCalls": [
        {
          "path": "callNamed:agentbrowser.agent_browser_tab_switch",
          "args": {
            "tab": "9"
          }
        }
      ]
    }
  ]
}
