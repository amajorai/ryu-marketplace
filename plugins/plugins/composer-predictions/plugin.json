  },
  "homepage": "https://github.com/amajorai/ryu-marketplace/tree/main/plugins/plugins/composer-predictions",
  "repository": "https://github.com/amajorai/ryu-marketplace/tree/main/plugins/plugins/composer-predictions",
  "keywords": [
    "chat",
    "composer",
    "predictions",
    "autocomplete",
    "next message"
  ],
  "extensions": {
    "com.ryuhq.ryu": {
      "id": "@ryu/composer-predictions",
      "displayName": "Composer Predictions"
    }
  }
