{
  "tool": "memory.sync",
  "kind": "adapter",
  "code_file": "adapters/memory.sync.js",
  "adapter_tools": ["honcho.peer_upsert", "honcho.session_upsert"],
  "cases": [
    {
      "name": "an assistant turn is attributed to the assistant peer",
      "input": {
        "role": "assistant",
        "content": "done"
      },
      "defaults": {
        "workspace_id": "ws",
        "peer_id": "me",
        "assistant_peer_id": "bot",
        "session_id": "s1"
      },
      "provider": {
        "call": [
          [
            {
              "id": "m1"
            },
            {
              "id": "m2"
            }
          ]
        ]
      },
      "expect": {
        "stored": true,
        "count": 2,
        "peer": "bot",
        "session": "s1"
      },
      "expectCalls": [
        {
          "path": "callTool",
          "args": {
            "workspace_id": "ws",
            "session_id": "s1",
            "messages": [
              {
                "content": "done",
                "peer_id": "bot"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "a user turn upserts the user peer on 422 and retries",
      "input": {
        "role": "user",
        "content": "hi"
      },
      "defaults": {
        "workspace_id": "ws",
        "peer_id": "me"
      },
      "provider": {
        "call": [
          {
            "status": 422
          },
          [
            {
              "id": "m1"
            }
          ]
        ],
        "named": {
          "honcho.peer_upsert": [{}],
          "honcho.session_upsert": [{}]
        }
      },
      "expect": {
        "stored": true,
        "count": 1,
        "peer": "me",
        "session": "ryu"
      },
      "expectCalls": [
        {
          "path": "callTool",
          "args": {
            "workspace_id": "ws",
            "session_id": "ryu",
            "messages": [
              {
                "content": "hi",
                "peer_id": "me"
              }
            ]
          }
        },
        {
          "path": "callNamed:honcho.peer_upsert",
          "args": {
            "workspace_id": "ws",
            "id": "me"
          }
        },
        {
          "path": "callNamed:honcho.session_upsert",
          "args": {
            "workspace_id": "ws",
            "id": "ryu"
          }
        },
        {
          "path": "callTool",
          "args": {
            "workspace_id": "ws",
            "session_id": "ryu",
            "messages": [
              {
                "content": "hi",
                "peer_id": "me"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "a non-array provider answer is surfaced raw",
      "input": {
        "content": "hi"
      },
      "defaults": {
        "workspace_id": "ws",
        "peer_id": "me"
      },
      "provider": {
        "call": [
          {
            "status": 500,
            "error": "boom"
          }
        ]
      },
      "expect": {
        "raw": {
          "status": 500,
          "error": "boom"
        }
      },
      "expectCalls": [
        {
          "path": "callTool",
          "args": {
            "workspace_id": "ws",
            "session_id": "ryu",
            "messages": [
              {
                "content": "hi",
                "peer_id": "me"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "refuses without settings",
      "input": {
        "content": "hi"
      },
      "defaults": {
        "workspace_id": "ws"
      },
      "provider": {},
      "expect": {
        "stored": false,
        "error": "honcho: set the workspace id and peer id in the Honcho settings tab"
      },
      "expectCalls": []
    }
  ]
}
