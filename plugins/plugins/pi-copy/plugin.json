{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "ryu.pi-copy",
  "version": "0.1.14",
  "description": "Adds the copy_paste tool to the managed Pi agent, so it can copy or move a block of text between or within files byte-for-byte instead of retyping it.",
  "author": {
    "name": "Ryu",
    "url": "https://ryuhq.com"
  },
  "homepage": "https://github.com/amajorai/ryu-marketplace/tree/main/plugins/plugins/pi-copy",
  "repository": "https://github.com/amajorai/ryu-marketplace/tree/main/plugins/plugins/pi-copy",
  "keywords": [
    "copy",
    "paste",
    "move",
    "refactor",
    "files",
    "developer"
  ],
  "extensions": {
    "com.ryuhq.ryu": {
      "id": "@ryu/pi-copy",
      "displayName": "Copy & Paste"
    }
  }
}
