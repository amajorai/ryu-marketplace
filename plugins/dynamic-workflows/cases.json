{
  "tool": "workflow__run",
  "kind": "inline_tool",
  "code_file": "tools/workflow__run.js",
  "cases": [
    {
      "name": "runs two delegates with bounded caps",
      "input": {
        "tasks": [
          { "id": "docs", "task": "Find the public docs entry point", "preset": "research" },
          { "id": "tests", "task": "List the focused tests", "preset": "code_read" }
        ],
        "max_concurrent": 2,
        "wall_time_secs": 30,
        "max_tokens": 1000
      },
      "host": {
        "runFanout": [
          {
            "ok": true,
            "results": [
              { "id": "docs", "output": "docs/index", "error": null },
              { "id": "tests", "output": "tests", "error": null }
            ]
          }
        ]
      },
      "expectCalls": [{ "path": "host.runFanout", "args": { "delegates": [{ "id": "docs", "task": "Find the public docs entry point", "preset": "research" }, { "id": "tests", "task": "List the focused tests", "preset": "code_read" }], "caps": { "max_concurrent": 2, "wall_time_secs": 30, "max_tokens": 1000 } } }],
      "expect": { "ok": true, "count": 2, "results": [{ "id": "docs", "output": "docs/index", "error": null }, { "id": "tests", "output": "tests", "error": null }] }
    },
    {
      "name": "defaults a single inline delegate and forwards its effect call",
      "input": {
        "tasks": [{ "task": "Summarise the release note", "system_prompt": "You are a concise release-note editor", "tools": ["read_file"] }]
      },
      "host": {
        "runFanout": [{ "ok": true, "results": [{ "id": "delegate-1", "preset": "code_read", "output": "summary", "error": null }] }]
      },
      "expectCalls": [{ "path": "host.runFanout", "args": { "delegates": [{ "id": "delegate-1", "task": "Summarise the release note", "preset": "code_read", "inline": { "system_prompt": "You are a concise release-note editor", "tools": ["read_file"] } }], "caps": {} } }],
      "expect": { "ok": true, "count": 1, "results": [{ "id": "delegate-1", "preset": "code_read", "output": "summary", "error": null }] }
    },
    {
      "name": "rejects an empty task list",
      "input": { "tasks": [] },
      "expectError": "'tasks' must contain"
    },
    {
      "name": "rejects duplicate ids before calling the host",
      "input": { "tasks": [{ "id": "same", "task": "one" }, { "id": "same", "task": "two" }] },
      "expectError": "duplicate task id"
    },
    {
      "name": "rejects ineffective write preset",
      "input": { "tasks": [{ "task": "change the code", "preset": "code_write" }] },
      "expectError": "unknown preset"
    },
    {
      "name": "rejects oversized token cap",
      "input": { "tasks": [{ "task": "summarise the code" }], "max_tokens": 32769 },
      "expectError": "max_tokens"
    }
  ]
}
