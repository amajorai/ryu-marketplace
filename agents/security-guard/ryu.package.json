{
  "$schema": "https://raw.githubusercontent.com/amajorai/ryu-closed/main/tools/marketplace-overlay/schema/ryu.package.schema.json",
  "schemaVersion": 1,
  "id": "ryu/security-guard",
  "name": "Security Guard",
  "version": "0.2.0",
  "kind": "agent",
  "artifacts": [
    "agent.json"
  ],
  "targets": [
    "ryu-desktop",
    "ryu-cli"
  ],
  "scopes": [
    "agent"
  ],
  "requires": {},
  "capabilities": [
