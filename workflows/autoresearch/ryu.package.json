{
  "$schema": "https://raw.githubusercontent.com/amajorai/ryu-closed/main/tools/marketplace-overlay/schema/ryu.package.schema.json",
  "schemaVersion": 1,
  "id": "ryu/workflow/autoresearch",
  "name": "Autoresearch",
  "version": "0.2.5",
  "kind": "workflow",
  "artifacts": [
    "workflow.json"
  ],
  "targets": [
    "ryu-desktop",
    "ryu-cli"
  ],
  "scopes": [
    "workflow"
  ],
  "requires": {
    "@ryu/research": ">=0.1.17",
    "@ryu/rlm": ">=0.1.16"
  },
  "capabilities": [
    "workflow:verified-experiment-loop",
    "research:durable-campaigns",
    "rlm:recursive-evidence"
  ],
  "source": {
    "type": "github",
    "repository": "amajorai/ryu-closed",
    "path": "marketplace-store/workflows/autoresearch",
    "ref": "main"
  },
  "security": {
    "containsSecrets": false,
    "permissions": [],
    "privateContent": false,
    "redacted": false
  },
  "metadata": {
    "description": "Runs one durable Research campaign with snapshot-bound proposals, automatic recursive RLM analysis, engine-owned winner selection, and policy-based stopping.",
    "category": "research",
    "pattern": "verified-experiment-loop",
    "icon": "FlaskConical",
    "nodeCount": 5,
    "tags": [
      "research",
      "experiments",
      "loop",
      "rlm",
      "durable"
    ]
  }
}
